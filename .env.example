# ════════════════════════════════════════════════════════════════════
# .env.example — Velvet Store
# ════════════════════════════════════════════════════════════════════
# Copie este arquivo para .env e preencha com valores reais.
# NUNCA comite o .env de verdade. Garanta que ele está no .gitignore.
# ════════════════════════════════════════════════════════════════════

# ─── Ambiente ───────────────────────────────────────────────────────
NODE_ENV=development                # development | production
PORT=3000

# URL pública do frontend (usada em emails, redirects do Mercado Pago, CORS fallback)
FRONTEND_URL=http://localhost:3000


# ─── Banco de dados (MySQL) ─────────────────────────────────────────
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=                        # ← troque a senha que vazou e ponha a nova aqui
DB_NAME=velvet_store
DB_PORT=3306


# ─── JWT (obrigatório — servidor não sobe sem isso) ─────────────────
# Mínimo 32 caracteres. Gere com:
#   openssl rand -hex 64
JWT_SECRET=COLOQUE_AQUI_UM_SECRET_LONGO_E_ALEATORIO_DE_PELO_MENOS_64_CARACTERES

# Tempos de vida dos tokens (formato compatível com `ms`)
ACCESS_TOKEN_TTL=15m                # access token: curto (15 min)
REFRESH_TOKEN_TTL=7d                # refresh token: 7 dias
REFRESH_TOKEN_TTL_DAYS=7            # (usado pelo refreshTokenService)


# ─── CORS ───────────────────────────────────────────────────────────
# Lista de origens permitidas, separadas por vírgula. SEM espaços extras.
# Em produção, NUNCA deixe vazio — isso bloqueia tudo.
CORS_ORIGINS=http://localhost:3000,https://velvetstore.com.br,https://www.velvetstore.com.br


# ─── Mercado Pago ───────────────────────────────────────────────────
# Pegue em: https://www.mercadopago.com.br/developers/panel/app
MP_ACCESS_TOKEN=COLOQUE_O_NOVO_ACCESS_TOKEN_AQUI
MP_PUBLIC_KEY=COLOQUE_A_NOVA_PUBLIC_KEY_AQUI

# Webhook secret — OBRIGATÓRIO em produção.
# Onde pegar:
#   1. Painel MP → Suas integrações → escolha o app
#   2. Webhooks → "Sua chave secreta" (mostra um cadeado, clique pra revelar)
#   3. Cole o valor aqui.
# Sem isso, o webhook é rejeitado em produção (em dev, passa com aviso).
MP_WEBHOOK_SECRET=COLOQUE_SEU_SECRET_AQUI


# ─── Melhor Envio (cálculo de frete) ────────────────────────────────
MELHOR_ENVIO_TOKEN=COLOQUE_O_NOVO_TOKEN_AQUI
MELHOR_ENVIO_USER_AGENT=VelvetAtelier contato@velvetstore.com.br

# CEP de origem (loja física / centro de distribuição)
CEP_ORIGEM=01310100


# ─── Resend (envio de email) ────────────────────────────────────────
# https://resend.com/api-keys
RESEND_API_KEY=re_COLOQUE_A_NOVA_KEY_AQUI
RESEND_FROM_EMAIL=naoresponda@velvetstore.com.br
RESEND_FROM_NAME=Velvet Store


# ─── Login social (opcional) ────────────────────────────────────────
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=


# ════════════════════════════════════════════════════════════════════
# CHECKLIST DE DEPLOY
# ════════════════════════════════════════════════════════════════════
# [ ] Rotacionar TODAS as chaves que vazaram no .env antigo:
#       - JWT_SECRET, MP_ACCESS_TOKEN, MP_PUBLIC_KEY,
#         MELHOR_ENVIO_TOKEN, RESEND_API_KEY, DB_PASSWORD
# [ ] Rodar migration: mysql velvet_store < database/migrations/008_security.sql
# [ ] Configurar webhook no painel MP e pegar MP_WEBHOOK_SECRET
# [ ] Em produção: NODE_ENV=production e HTTPS obrigatório
# [ ] Em produção: CORS_ORIGINS sem localhost
# [ ] Verificar que `.env` está no `.gitignore`
# ════════════════════════════════════════════════════════════════════
